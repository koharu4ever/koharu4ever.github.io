{
  "name": "koharu4ever-site-source",
  "version": "0.1.0",
  "private": true,
  "hexo": {
    "version": "8.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "hexo clean && hexo server --draft --host 0.0.0.0",
    "build": "hexo clean && hexo generate",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "clean": "hexo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --no-error-on-unmatched-pattern \"*.{js,mjs,cjs}\" \"scripts/**/*.{js,mjs,cjs}\" \"source/**/*.{js,mjs,cjs}\"",
    "new:post": "hexo new post",
    "new:page": "hexo new page"
  },
  "dependencies": {
    "@tabler/core": "1.4.0",
    "hexo": "8.0.0",
    "hexo-browser-reloader-websocket": "1.1.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-hot-config": "1.0.1",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "5.5.0",
    "hexo-wordcount": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6"
  }
}
